# ─────────── REQUIRED ───────────
# App will not start without these.

# App URL (used for auth callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Database (any PostgreSQL; Docker default shown).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umkmcepat?schema=public"

# Auth (Google OAuth).
NEXTAUTH_SECRET="replace-with-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider (9Router / OpenAI-compatible proxy).
AI_PROVIDER="9router"
NINE_ROUTER_BASE_URL="http://localhost:20129/v1"
NINE_ROUTER_API_KEY=""

# Object storage (local = RustFS dev mirror, r2 = Cloudflare R2).
STORAGE_PROVIDER="local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BUCKET="umkmcepat-public-dev"
S3_PRIVATE_BUCKET="umkmcepat-private-dev"
S3_PUBLIC_BASE_URL="http://localhost:9000"
S3_ACCOUNT_ID=""

# ─────────── OPTIONAL ───────────
# Empty = dev mock / bypass. Fill when you need the feature.

# Auth / security.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
ADMIN_EMAILS=""

# Transactional email (Resend; empty = mock mode, logs to console).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# WhatsApp OTP (OTPSpace; empty = mock mode, logs to console).
OTP_SPACE_API_KEY=""

# Payment (Pakasir).
PAKASIR_API_KEY=""
PAKASIR_PROJECT_SLUG=""

# Analytics (Umami; empty = dev no-op).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT_SRC=""

# Public origin for published generated sites (empty = no public access).
# Set to a cookie-free HTTPS origin that differs from the control plane.
GENERATED_PUBLIC_ORIGIN=""

# GitHub token (optional; raises rate limit for contributors strip).
GITHUB_TOKEN=""

# Runtime paths (local filesystem; non-secret infra config).
PROJECT_RUNTIME_DIR=".data/project-runtimes"
PROJECT_BUILD_WORKSPACE_DIR=".data/project-build-workspaces"
PROJECT_RUNTIME_SUPERVISOR="local"
PROJECT_RUNTIME_ALLOWED_HOSTS="127.0.0.1,localhost"

# Thumbnail capture — set these only if headless Chromium is not on PATH.
# PROJECT_THUMBNAIL_BROWSER_PATH="/usr/bin/chromium"
# PROJECT_THUMBNAIL_NODE_PATH="/usr/bin/node"

# ─────────── PRODUCTION ONLY ───────────
# Required when deploying via docker-compose.prod.yml.

APP_IMAGE_TAG=""
CLOUDFLARE_TUNNEL_TOKEN=""
UMAMI_APP_SECRET=""

# ─────────── LEGACY OVERRIDES ───────────
# These values are now DB-first via /admin/settings.
# Uncomment only if you need a boot-time floor BEFORE the first admin edit.

# RATE_LIMIT_GLOBAL_IP_REQUESTS="300"
# RATE_LIMIT_AI_USER_REQUESTS="60"
# RATE_LIMIT_BUILD_USER_REQUESTS="10"
# AI_TIMEOUT_MODERATION_MS="30000"
# AI_TIMEOUT_DISCUSS_MS="90000"
# PROJECT_LIMIT="5"
# WAITLIST_ENABLED="false"
