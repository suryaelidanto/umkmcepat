# ───────────────────────────── REQUIRED ─────────────────────────────
# App must not start without these.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (any PostgreSQL provider; local Docker default shown).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umkmcepat?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="umkmcepat"

# Auth (Google OAuth).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-local-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider (9Router proxy, OpenAI-compatible; combo handles model fallback).
AI_PROVIDER="9router"
AI_MODELS="umkmcepat-combo"

# 9Router proxy.
NINE_ROUTER_BASE_URL="http://localhost:20129/v1"
NINE_ROUTER_API_KEY=""

# Object storage — one S3 path. local = RustFS (dev mirror); r2 = Cloudflare R2 (prod).
STORAGE_PROVIDER="local"

# S3 config (applies to whichever provider STORAGE_PROVIDER names).
# r2: leave S3_ENDPOINT empty (SDK derives the R2 host from S3_ACCOUNT_ID); region "auto".
# local: RustFS at http://localhost:9000; region "us-east-1".
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BUCKET="umkmcepat-public-dev"
S3_PRIVATE_BUCKET="umkmcepat-private-dev"
S3_PUBLIC_BASE_URL="http://localhost:9000"
S3_ACCOUNT_ID=""

# RustFS root creds (used by scripts/init-s3-buckets.ts to auto-create buckets).
RUSTFS_ROOT_USER="umkmcepat"
RUSTFS_ROOT_PASSWORD=""

# Rate limit provider (memory | none).
RATE_LIMIT_PROVIDER="memory"
RATE_LIMIT_GLOBAL_IP_REQUESTS="300"
RATE_LIMIT_GLOBAL_IP_WINDOW_SECONDS="60"
RATE_LIMIT_AI_USER_REQUESTS="60"
RATE_LIMIT_AI_USER_WINDOW_SECONDS="600"
RATE_LIMIT_AI_IP_REQUESTS="20"
RATE_LIMIT_AI_IP_WINDOW_SECONDS="600"
RATE_LIMIT_BUILD_USER_REQUESTS="10"
RATE_LIMIT_BUILD_USER_WINDOW_SECONDS="3600"
RATE_LIMIT_BUILD_IP_REQUESTS="5"
RATE_LIMIT_BUILD_IP_WINDOW_SECONDS="3600"

# Generated runtime/build workspace paths (process execution, not object storage).
PROJECT_RUNTIME_DIR=".data/project-runtimes"
PROJECT_BUILD_WORKSPACE_DIR=".data/project-build-workspaces"
PROJECT_RUNTIME_SUPERVISOR="local"
PROJECT_RUNTIME_MAX_CONTAINERS="8"
PROJECT_RUNTIME_ALLOWED_HOSTS="127.0.0.1,localhost"
PROJECT_RUNTIME_HEALTH_TIMEOUT_MS="2000"
PROJECT_RUNTIME_PROXY_TIMEOUT_MS="15000"
PREVIEW_ASSET_TOKEN_TTL_SECONDS="300"
PROJECT_BUILD_CONCURRENCY="1"

# ───────────────────────────── OPTIONAL ─────────────────────────────
# Empty = dev/mock/bypass. Fill only when you need the feature.

# Cloudflare Turnstile (empty = dev check).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Admin allowlist (comma-separated emails). Fail-closed: empty grants nobody
# admin access, in every environment. See src/lib/waitlist.ts isAdminEmail().
ADMIN_EMAILS=""
# Waitlist onboarding gate (true = require approved entry; false = pass-through). Unset defaults true (fail-safe).
WAITLIST_ENABLED="false"

# Chromatic visual tests (optional).
CHROMATIC_PROJECT_TOKEN=""

# GitHub token (optional; raises rate limit for contributors strip).
GITHUB_TOKEN=""

# AI per-call timeouts (ms).
AI_TIMEOUT_MODERATION_MS="30000"
AI_TIMEOUT_DISCUSS_MS="90000"
AI_TIMEOUT_DISCUSS_TOOL_SETTLE_MS="30000"
AI_TIMEOUT_CHAT_COMPACTION_MS="60000"
AI_TIMEOUT_BUILD_SPEC_MS="120000"
AI_TIMEOUT_SOURCE_GENERATION_MS="600000"
AI_TIMEOUT_EDIT_MS="600000"
AI_TIMEOUT_EDIT_REPAIR_MS="300000"

# Agent tool-loop step budgets (brake only).
AI_AGENT_GENERATE_MAX_STEPS="12"
AI_AGENT_REPAIR_MAX_STEPS="12"
AI_AGENT_SUBAGENT_MAX_STEPS="8"

# Max projects per user before a soft warning.
PROJECT_LIMIT="3"

# Generated app execution safety (prod Compose hardcodes off until gates pass).
GENERATED_BUILD_EXECUTION_ENABLED="true"
GENERATED_PUBLIC_EXECUTION_ENABLED="true"
GENERATED_PUBLIC_ORIGIN=""
DISCUSS_ONE_CALL_TOOLS="true"

# Thumbnail capture (headless browser screenshots).
PROJECT_THUMBNAIL_CAPTURE_ENABLED="true"
PROJECT_THUMBNAIL_BROWSER_PATH=""
PROJECT_THUMBNAIL_NODE_PATH=""
PROJECT_THUMBNAIL_CONCURRENCY="1"
PROJECT_THUMBNAIL_TIMEOUT_MS="15000"

# Generated source/dist resource limits.
PROJECT_SOURCE_MAX_FILES="100"
PROJECT_SOURCE_MAX_FILE_BYTES="262144"
PROJECT_SOURCE_MAX_TOTAL_BYTES="5242880"
PROJECT_DIST_MAX_FILES="500"
PROJECT_DIST_MAX_FILE_BYTES="10485760"
PROJECT_DIST_MAX_TOTAL_BYTES="52428800"

# Preview asset token rotation (empty = use NEXTAUTH_SECRET/AUTH_SECRET).
PREVIEW_ASSET_TOKEN_SECRETS=""

# Transactional email (Resend; empty = mock mode, dev only).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_BASE_URL=""

# WhatsApp OTP (OTPSpace; empty = mock mode, logs to console).
OTP_SPACE_API_KEY=""

# Umami analytics (empty = dev no-op; set website id + script src in prod).
# UMAMI_BASE_URL: dev = local container; prod = https://umami.<yourdomain>.
# UMAMI_ADMIN_PASSWORD: dev empty = default "umami" + warn; prod required (script errors if empty).
UMAMI_BASE_URL="http://localhost:3001"
UMAMI_ADMIN_PASSWORD=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT_SRC=""

# Pakasir payment integration.
PAKASIR_API_KEY=""
PAKASIR_PROJECT_SLUG=""
