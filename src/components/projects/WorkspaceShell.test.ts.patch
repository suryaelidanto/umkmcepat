+            businessType: "Kedai kopi",
+            description: "Kopi susu tetangga",
+            audience: "Anak muda",
+            style: "Modern",
+            primaryGoal: "Pesan online",
+            tone: "Santai",
+          },
+        })
+      )
+    );
+
+    // Mobile tree carries lg:hidden class on its flex-1 wrapper.
+    expect(html).toContain("lg:hidden");
