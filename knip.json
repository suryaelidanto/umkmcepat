{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/**/*.{test,itest}.{ts,tsx}",
    "tests/**/*.{test,itest}.{ts,tsx}",
    ".husky/pre-commit",
    ".husky/commit-msg",
    "scripts/capture-project-thumbnail.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreBinaries": ["graphify", "netstat"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/components/ui/**": ["exports"],
    "src/lib/ai/provider-registry.ts": ["exports"],
    "src/lib/config/app-settings-registry.ts": ["exports"],
    "src/lib/zod-schemas.ts": ["exports", "types"],
    "src/components/admin/streamer-mode/streamer-mode-context.tsx": [
      "exports",
      "files"
    ],
    "src/components/admin/streamer-mode/SensitiveText.tsx": [
      "exports",
      "files"
    ],
    "src/lib/storage/uploads/temp-image-client.ts": ["exports"],
    "src/lib/storage/uploads/temp-image-storage.ts": ["exports"],
    "src/lib/projects/generated-site-contract.ts": ["exports"],
    "src/lib/projects/brief-admission.ts": ["exports"],
    "src/components/projects/workspace/WorkspaceShell.tsx": ["exports"],
    "src/lib/projects/canonical-brief.ts": ["exports"],
    "src/lib/projects/runtime-idle-runner.ts": ["files"]
  }
}
