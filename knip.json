{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/**/*.test.ts",
    "tests/**/*.test.ts",
    ".husky/pre-commit",
    ".husky/commit-msg",
    "scripts/capture-project-thumbnail.cjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreBinaries": [
    "chromatic",
    "eslint",
    "graphify",
    "husky",
    "knip",
    "netstat",
    "prettier",
    "prisma",
    "storybook",
    "tsc",
    "vite",
    "vitest"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@storybook/react",
    "chromatic",
    "eslint",
    "husky",
    "monaco-editor",
    "prettier",
    "prisma",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/components/ui/**": ["exports"],
    "src/lib/provider-registry.ts": ["exports"],
    "src/lib/storage/index.ts": ["exports"],
    "src/lib/app-settings-registry.ts": ["exports"],
    "src/lib/zod-schemas.ts": ["exports", "types"],
    "src/components/admin/streamer-mode-context.tsx": ["exports", "files"],
    "src/components/admin/SensitiveText.tsx": ["exports", "files"]
  }
}
